#!/usr/bin/env bash
# Runs before every `git push`. Enable once per clone:
#   git config core.hooksPath .githooks
# Blocks the push when the leak guard or the secret scan fails. CI repeats
# both checks, but CI runs after the push; this is the step that stops it.
set -euo pipefail
root="$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue            # branch deletion
  if [ "$remote_sha" = "$zero" ]; then range="$local_sha"; else range="$remote_sha..$local_sha"; fi
  "$root/scripts/leak-guard.sh" "$range" || status=1
  if command -v gitleaks >/dev/null 2>&1; then
    gitleaks git --no-banner --redact --log-opts="$range" "$root" || status=1
  else
    echo "pre-push: gitleaks not installed (brew install gitleaks); secret scan skipped, CI will run it" >&2
  fi
done
if command -v go >/dev/null 2>&1; then
  (cd "$root" && go vet ./... && go test ./...) || status=1
fi
if [ "$status" -ne 0 ]; then
  echo "pre-push: push blocked. Fix the findings above (bypass only with --no-verify, and only knowingly)." >&2
fi
exit "$status"
